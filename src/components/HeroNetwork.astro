---
import { networkNodes, networkEdges } from '../data/hero-network';
---
<div class="hero-network">
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 640 580" class="connecting-dots" focusable="false">
      <defs>
        <radialGradient id="network-atmosphere">
          <stop stop-color="#2563A6" stop-opacity=".24" />
          <stop offset="1" stop-color="#0B1F3A" stop-opacity="0" />
        </radialGradient>
      </defs>
      <ellipse cx="320" cy="290" rx="300" ry="270" fill="url(#network-atmosphere)" />
      <g class="network-constellation">
        <g fill="none" stroke="#507DA8" stroke-width="1">
          {networkEdges.map(edge => <line x1={networkNodes[edge.from].x} y1={networkNodes[edge.from].y} x2={networkNodes[edge.to].x} y2={networkNodes[edge.to].y} opacity={edge.opacity} />)}
        </g>
        <g fill="none" stroke="#ffffff" stroke-width="1.4" stroke-linecap="round">
          {networkEdges.filter((_, index) => index % 7 === 0).map((edge, index) =>
            <path class="network-signal" d={`M${networkNodes[edge.from].x} ${networkNodes[edge.from].y}L${networkNodes[edge.to].x} ${networkNodes[edge.to].y}`} pathLength="100" style={`--delay:${-index * 1.3}s`} />
          )}
        </g>
        {networkNodes.map((node, index) => <g>
          {index % 9 === 0 && <circle class="network-ring" cx={node.x} cy={node.y} r="12" fill="none" stroke="#507DA8" stroke-opacity=".65" />}
          <circle class="network-point" cx={node.x} cy={node.y} r={node.radius} fill={index % 9 === 0 ? '#ffffff' : '#507DA8'} style={`--delay:${node.delay}s`} />
        </g>)}
      </g>
    </svg>
  </div>
  <button class="animation-toggle" id="animation-toggle" type="button" aria-pressed="false" hidden>Pausar animación</button>
</div>
