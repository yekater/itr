---
const sources = [
  { y: 80, icon: 'web', route: 'M200 130C260 130 245 290 300 290' },
  { y: 240, icon: 'registry', route: 'M200 290H300' },
  { y: 400, icon: 'document', route: 'M200 450C260 450 245 290 300 290' },
];
const phases = ['Recopilando información', 'Contrastando relaciones', 'Preparando expediente', 'Expediente preparado'];
---
<div class="hero-investigation">
  <div class="investigation-heading"><span>DEL DATO AL EXPEDIENTE</span><span class="pill">Demostración visual</span></div>
  <div class="hero-art" aria-hidden="true">
    <svg viewBox="0 0 640 580" class="investigation-scene" focusable="false">
      <defs>
        <radialGradient id="investigation-atmosphere"><stop stop-color="#2563A6" stop-opacity=".25"/><stop offset="1" stop-color="#0B1F3A" stop-opacity="0"/></radialGradient>
        <linearGradient id="investigation-paper" x2="1" y2="1"><stop stop-color="#1b426b"/><stop offset="1" stop-color="#102c4a"/></linearGradient>
      </defs>
      <ellipse cx="355" cy="290" rx="285" ry="265" fill="url(#investigation-atmosphere)"/>
      <g fill="#507DA8" opacity=".3">{Array.from({length: 18}, (_, i) => <circle cx={30 + (i * 97) % 580} cy={30 + (i * 83) % 520} r="1.4"/>)}</g>
      <g fill="none" stroke="#507DA8" stroke-width="1.5">
        {sources.map(source => <path d={source.route} opacity=".45"/>)}
        <path d="M340 290H405" opacity=".55"/>
      </g>
      {sources.map((source, i) => <g class="source-card" transform={`translate(50 ${source.y})`}>
        <rect width="150" height="100" rx="12" fill="#102c4a" stroke="#507DA8"/>
        <g transform="translate(19 18)" fill="none" stroke="#c5dff2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          {source.icon === 'web' ? <><rect width="33" height="28" rx="4"/><path d="M0 7H33M5 3.5H6M10 3.5H11"/><circle cx="16.5" cy="18" r="7"/><path d="M9.5 18H23.5M16.5 11C12 14 12 22 16.5 25C21 22 21 14 16.5 11Z"/></>
            : source.icon === 'registry' ? <><ellipse cx="16.5" cy="5" rx="16" ry="5"/><path d="M.5 5V25C.5 32 32.5 32 32.5 25V5M.5 15C.5 22 32.5 22 32.5 15"/></>
            : <><path d="M5 0H23L32 9V33H5Z M23 0V9H32M11 16H25M11 22H25M11 28H21"/></>}
        </g>
        <g fill="#507DA8"><rect x="66" y="24" width="62" height="4" rx="2"/><rect x="66" y="36" width="46" height="4" rx="2" opacity=".55"/><rect x="19" y="68" width="109" height="3" rx="1.5" opacity=".5"/><rect x="19" y="80" width={72 + i * 13} height="3" rx="1.5" opacity=".3"/></g>
        <circle class="source-confirmation" cx="134" cy="84" r="3" fill="#c5dff2"/>
      </g>)}
      {sources.map((source, i) => <circle class="collection-packet" r="3.5" fill="#ffffff" style={`offset-path:path('${source.route}');--packet-delay:${i * .45}s`}/>)}
      <g class="analysis-hub">
        <circle cx="300" cy="290" r="53" fill="#0B1F3A" stroke="#2563A6" stroke-opacity=".4"/>
        <circle cx="300" cy="290" r="40" fill="#163A63" stroke="#507DA8"/>
        <circle class="analysis-orbit" cx="300" cy="290" r="47" fill="none" stroke="#c5dff2" stroke-width="2" stroke-dasharray="18 82" pathLength="100"/>
        <path d="M285 300L300 273L315 300Z" fill="none" stroke="#507DA8" stroke-width="1.5"/>
        <circle cx="300" cy="273" r="4" fill="#c5dff2"/><circle cx="285" cy="300" r="4" fill="#c5dff2"/><circle cx="315" cy="300" r="4" fill="#c5dff2"/>
      </g>
      <path class="report-transfer" d="M340 290H405" pathLength="100" fill="none" stroke="#ffffff" stroke-width="2" stroke-dasharray="6 94"/>
      <g class="investigation-report">
        <path d="M395 190V427Q395 437 405 437H560" fill="none" stroke="#507DA8" stroke-opacity=".3"/>
        <path d="M415 165H533L583 215V405Q583 415 573 415H415Q405 415 405 405V175Q405 165 415 165Z" fill="url(#investigation-paper)" stroke="#507DA8" stroke-width="1.5"/>
        <path d="M533 165V205Q533 215 543 215H583" fill="#163A63" stroke="#507DA8"/>
        <g fill="#c5dff2"><rect x="427" y="190" width="8" height="8" rx="1.5"/><rect x="441" y="190" width="8" height="8" rx="1.5" opacity=".6"/><rect x="455" y="190" width="8" height="8" rx="1.5" opacity=".35"/></g>
        <g fill="none" stroke="#c5dff2" stroke-linecap="round">
          {[246,267,288,309,330,351].map((y, i) => <path class="report-line" d={`M427 ${y}H${i % 3 === 2 ? 525 : 559}`} pathLength="100" stroke-width={i === 0 ? '4' : '2'} opacity={i === 0 ? '.9' : '.45'} style={`--line-delay:${i * .3}s`}/>)}
        </g>
        <g class="report-ready"><circle cx="550" cy="383" r="16" fill="#163A63" stroke="#c5dff2"/><path d="M543 383L548 388L557 378" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></g>
      </g>
    </svg>
  </div>
  <div class="investigation-caption" aria-hidden="true">{phases.map((phase, i) => <p class={`investigation-phase investigation-phase-${i}`}><span>0{Math.min(i + 1, 3)} / </span>{phase}<span class="phase-status">{i === 3 ? 'LISTO' : 'EN PROCESO'}</span></p>)}</div>
  <div class="investigation-progress" aria-hidden="true"><span/></div>
  <div class="investigation-footer"><p>Fuentes públicas · Contraste · Informe</p><button class="animation-toggle" id="animation-toggle" type="button" aria-pressed="false" hidden>Pausar animación</button></div>
  <p class="sr-only">Secuencia ilustrativa con datos simulados: recopilar información de fuentes públicas, contrastar relaciones y preparar un expediente de investigación. No se realiza una investigación real.</p>
</div>
