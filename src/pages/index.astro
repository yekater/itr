---
import '../styles/global.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import {curriculum} from '../data/curriculum';
import {benefits,learning,faq,duration,durationNote,certification,CORPORATE_URL} from '../data/site';
import {destination} from '../lib/links';
import HeroBackground from '../components/HeroBackground';
import HeroInvestigation from '../components/HeroInvestigation.astro';
import EvidenceCase from '../components/EvidenceCase';
import Audience from '../components/Audience';
import Planner from '../components/Planner';
const production=import.meta.env.PUBLIC_DEPLOY_ENV==='production';
const canonical=new URL('/',Astro.site).href;
const contact=(id:string)=>destination('contact',id),course=(id:string)=>destination('course',id);
const schema={'@context':'https://schema.org','@graph':[{'@type':'Organization','@id':CORPORATE_URL+'#organization',name:'iTR+',url:CORPORATE_URL},{'@type':'WebSite','@id':canonical+'#website',url:canonical,name:'iTR+ · OSINT para abogados',inLanguage:'es-ES'},{'@type':'Course',name:'Curso OSINT para abogados',description:'Formación especializada en investigación digital mediante fuentes abiertas',url:canonical,provider:{'@id':CORPORATE_URL+'#organization'}}]};
---
<!doctype html><html lang="es-ES"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Curso OSINT para abogados | Investigación digital · iTR+</title><meta name="description" content="Aprende a buscar, contrastar y documentar información pública para tu práctica jurídica. Curso OSINT online de iTR+. Consulta programa y condiciones."/><meta name="robots" content={production?'index,follow':'noindex,follow'}/><link rel="canonical" href={canonical}/><meta property="og:title" content="Investiga más allá de los documentos · iTR+"/><meta property="og:description" content="Curso OSINT para abogados. Aprende a localizar, contrastar y documentar información pública."/><meta property="og:type" content="website"/><meta property="og:locale" content="es_ES"/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/images/social.png',Astro.site).href}/><meta name="twitter:card" content="summary_large_image"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/></head><body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="header"><a class="wordmark" href="#inicio" aria-label="iTR+, inicio">iTR<span>+</span></a><span class="brand-caption">INVESTIGACIÓN<br/>Y FORMACIÓN DIGITAL</span><nav aria-label="Navegación principal"><a href="#aplicaciones">Aplicaciones</a><a href="#para-quien">Para quién</a><a href="#programa">Programa</a><a href="#formacion">Formación</a><a href="#preguntas">Preguntas</a></nav><a class="button compact" href={contact('cabecera')}>Solicitar información <span aria-hidden="true"><svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a><details class="mobile-menu"><summary>Menú</summary><nav aria-label="Navegación móvil"><a href="#aplicaciones">Aplicaciones</a><a href="#para-quien">Para quién</a><a href="#programa">Programa</a><a href="#formacion">Formación</a><a href="#preguntas">Preguntas</a><a href={contact('menu')}>Solicitar información</a></nav></details></header>
<main id="contenido">
<section class="hero" id="inicio"><HeroBackground client:idle/><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> Curso OSINT para abogados · iTR+</p><h1>Investiga más allá de los documentos. <span>Descubre el potencial del OSINT para abogados</span></h1><p class="hero-intro">Aprende técnicas de investigación digital para localizar y documentar información pública relevante.</p><p class="hero-value">Aprende a buscar, contrastar y documentar fuentes abiertas con una metodología práctica y rigurosa.</p><div class="actions"><a class="button light" href={contact('hero_principal')}>Solicita información del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a class="button outline" href="/downloads/programa-osint-abogados.pdf" download>Descargar programa ↓</a></div><div class="text-links"><a href="#programa">Explorar el programa <span aria-hidden="true">→</span></a><a href={course('hero_ficha')}>Información completa del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div><HeroInvestigation/></div><div class="container hero-facts"><div><strong>100 %</strong><span>online, a tu ritmo</span></div><div><strong>7 módulos</strong><span>de lo básico a lo avanzado</span></div><div><strong>38 lecciones</strong><span>y evaluación final</span></div><div><strong>≈60 horas</strong><span>carga formativa estimada*</span></div></div><p class="container hero-footnote">*{duration} {durationNote}</p></section>
<section id="aplicaciones" class="section container"><div class="section-head"><p class="eyebrow">01 / INFORMACIÓN QUE APORTA CONTEXTO</p><h2>¿Qué puede aportar OSINT a tu trabajo como abogado?</h2><p>¿Cómo puede ayudarte el OSINT en tu práctica jurídica? La inteligencia de fuentes abiertas permite buscar, analizar y contrastar información pública. OSINT aplicado al ámbito jurídico, con método y límites claros.</p></div><div class="benefit-grid">{benefits.map(([title,description,extra],i)=><article class="benefit"><span class="number">0{i+1} /</span><h3>{title}</h3><p>{description}</p><p class="muted">{extra}</p></article>)}</div><EvidenceCase client:visible/><div class="section-end"><p>Aprende una metodología para localizar, contrastar y documentar información pública. Técnicas OSINT para abogados, aplicadas con criterio.</p><a class="button" href={contact('expediente')}>Solicitar información del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></section>
<section id="para-quien" class="section surface"><div class="container"><div class="section-head"><p class="eyebrow">02 / TU PRÁCTICA, MÁS PERSPECTIVA</p><h2>¿A quién va dirigido?</h2><p>Dirigido a abogados y profesionales del derecho interesados en investigación OSINT. Selecciona tu especialidad para explorar una aplicación.</p></div><Audience client:visible={{rootMargin:"300px"}}/><details class="secondary-audience"><summary>También para quienes amplían su mirada digital</summary><p>Descubre el mundo del OSINT y aprende técnicas de investigación digital. Aprende técnicas OSINT para buscar y analizar información en internet.</p><p>Una formación 100 % online dirigida a estudiantes y personas interesadas en adquirir conocimientos sobre investigación digital, conocer herramientas OSINT y aprender a trabajar con información pública.</p><ul><li><strong>Abogados y pasantes de despachos pequeños y medianos:</strong> refuerza tu estrategia probatoria con información pública relevante.</li><li><strong>Alumnos:</strong> aprende a identificar empresas, titulares y riesgos reputacionales.</li><li><strong>Detectives privados habilitados:</strong> complementa tu formación técnica con investigaciones prácticas aplicadas al ámbito jurídico.</li><li><strong>Consultores antifraude:</strong> mejora la búsqueda y el análisis de datos públicos.</li><li><strong>Profesionales digitales, derecho digital, ciberseguridad y peritos informáticos:</strong> incorpora nuevas técnicas de investigación en fuentes abiertas.</li></ul><p>Esta formación no confiere habilitación como detective privado, perito acreditado ni una titulación oficial.</p></details></div></section>
<section id="programa" class="section container"><div class="section-head"><p class="eyebrow">03 / UN MÉTODO, PASO A PASO</p><h2>De la primera búsqueda<br/>al informe documentado.</h2><p>Descubre el potencial del OSINT y aprende técnicas de investigación digital para abogados. Búsqueda avanzada, investigación digital, herramientas OSINT e informes con enfoque práctico y jurídico.</p></div><div class="learning-grid">{learning.map(([title,description])=><article><h3>{title}</h3><p>{description}</p></article>)}</div><div class="program-heading"><div><h3>Tu programa de investigación</h3><p>7 módulos estructurados para progresar desde lo básico a lo avanzado. 38 lecciones prácticas con recursos y ejercicios guiados.</p></div><div class="program-tools"><button id="expand">Expandir todo</button><button id="collapse">Contraer todo</button></div></div><div class="curriculum">{curriculum.map((m,i)=><details data-module={i+1}><summary><span class="module-num">0{i+1}</span><span>{m.title}</span><span class="lesson-count">{m.lessons.length} lecciones</span><span class="plus" aria-hidden="true">+</span></summary><ol>{m.lessons.map((lesson,j)=><li><span>{i+1}.{j+1}</span> {lesson}</li>)}</ol></details>)}</div><div class="evaluation"><strong>+ Evaluación final</strong><p>Test final que valida los conocimientos adquiridos. Es adicional a las 38 lecciones, no un octavo módulo formativo.</p><a href="/downloads/programa-osint-abogados.pdf" download>Descargar programa completo ↓</a></div><div class="topic-notes"><details><summary>Conoce las competencias y su aplicación</summary><h3>Formación en técnicas OSINT</h3><p>Formación online de carga estimada de 60 horas dirigida a abogados, profesionales del derecho digital e investigadores. Aprende a buscar y analizar información, investigar personas y empresas, localizar en redes sociales, utilizar herramientas especializadas y analizar y documentar. {durationNote}</p><h3>Investigación de empresas y sociedades en fuentes abiertas</h3><p>Para abogados mercantiles, despachos jurídicos y consultores antifraude: consulta de registros públicos, directorios empresariales y herramientas digitales para recopilar y analizar datos.</p><h3>Investigación de identidades digitales y redes sociales</h3><p>Búsquedas avanzadas, análisis de perfiles públicos y verificación de fuentes. Una metodología estructurada que prioriza la fiabilidad y el respeto a la privacidad.</p><h3>Búsqueda avanzada de información en internet</h3><p>Operadores, localización de documentos y selección de fuentes fiables para profesionales jurídicos, consultores e investigadores.</p><h3>Elaboración y documentación de informes OSINT</h3><p>Recopilación de evidencias digitales e informes claros, estructurados y trazables, sin garantizar por sí mismos su validez judicial.</p></details></div></section>
<section id="formacion" class="section dark"><div class="container"><div class="section-head"><p class="eyebrow">04 / FORMACIÓN QUE ENCAJA CONTIGO</p><h2>Rigor en el método.<br/>Flexibilidad en tu agenda.</h2><p>Formación flexible, soporte técnico y materiales descargables. Una metodología de teoría, tutorías, revisión de casos prácticos, cuestionarios y evaluación.</p></div><div class="formation-grid"><div class="facts-list"><article><span>Modalidad</span><h3>100 % online, accesible a tu ritmo</h3><p>Con sesiones virtuales prácticas, según el programa facilitado. Consulta la planificación vigente.</p></article><article><span>Dedicación</span><h3>≈60 horas de carga estimada</h3><p>{duration}</p><p class="duration-note">{durationNote}</p></article><article><span>Estructura</span><h3>7 módulos y 38 lecciones</h3><p>Con tutorías y evaluación final.</p></article><article><span>Requisitos</span><h3>Sin conocimientos previos</h3><p>Enfoque práctico y legal. Incluye materiales y certificado final en las condiciones indicadas.</p></article></div><Planner client:visible={{rootMargin:"300px"}}/></div><div class="actions"><a class="button light" href={contact('formacion')}>Solicitar información del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a class="text-link" href={course('condiciones')}>Información completa y condiciones del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></section>
<section id="aplicacion-profesional" class="section container professional"><div class="editorial-visual" role="img" aria-label="Ilustración editorial de un registro de fuentes y un informe de investigación"><div class="document"><span class="eyebrow">iTR+ / CUADERNO DE INVESTIGACIÓN</span><h3>Del hallazgo<br/>al argumento.</h3><div class="document-line"></div><p>01 &nbsp; Fuente y procedencia</p><p>02 &nbsp; Contraste y contexto</p><p>03 &nbsp; Registro y limitaciones</p><div class="document-line"></div><span class="stamp">MÉTODO · CRITERIO · TRAZABILIDAD</span></div><span class="visual-caption">ILUSTRACIÓN / METODOLOGÍA OSINT</span></div><div><p class="eyebrow">05 / APLICACIÓN PROFESIONAL</p><h2>Investigar mejor.<br/>Documentar con criterio.</h2><p>Integra la metodología OSINT en investigaciones y diligencias previas. Mejora la obtención de indicios y la documentación de evidencias.</p><p>Aplicarás técnicas OSINT en la fase probatoria, la diligencia preprocesal y la investigación documental y digital.</p><dl class="professional-list"><dt>Practicidad inmediata</dt><dd>Herramientas y plantillas listas para incorporar a tu práctica diaria.</dd><dt>Rigor jurídico</dt><dd>Metodología orientada a guardar cadena de custodia y reproducibilidad. Su estudio no garantiza por sí solo la custodia ni la admisibilidad de una prueba.</dd><dt>Flexibilidad</dt><dd>Ritmo compatible con la carga de trabajo profesional.</dd></dl></div></section>
<section id="certificacion" class="section surface"><div class="container certification"><div><p class="eyebrow">06 / TRANSPARENCIA EN LA FORMACIÓN</p><h2>Conocimiento que puedes aplicar. Condiciones que puedes consultar.</h2></div><div><h3>Certificado final</h3><p>{certification}</p><p>Curso vinculado a «Acreditación Técnico Especialista en Análisis Forense en la Web». La palabra «acreditación» forma parte del nombre del producto.</p><a href={course('certificado')}>Consultar condiciones del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></section>
<section id="preguntas" class="section container faq"><div><p class="eyebrow">07 / ANTES DE EMPEZAR</p><h2>Preguntas<br/>frecuentes.</h2><p>La información pública exige un uso responsable: finalidad legítima, respeto a la privacidad, límites de acceso y documentación rigurosa.</p></div><div>{faq.map(([q,a])=><details class="faq-item"><summary>{q}<span aria-hidden="true">+</span></summary><p>{a}</p></details>)}<a class="text-link" href={course('faq')}>Acceder al curso en iTR+ <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></section>
<section id="informacion" class="section final dark"><div class="container"><p class="eyebrow">TU SIGUIENTE PASO</p><h2>Amplía tus herramientas<br/>de investigación jurídica.</h2><p>Da un paso más en tu investigación jurídica. Descubre nuevas posibilidades para localizar y analizar información pública y amplía tus conocimientos sobre investigación digital.</p><p>Consulta el programa, la dedicación y las condiciones de la formación.</p><div class="actions"><a class="button light" href={contact('cierre')}>Solicitar información del curso <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a><a class="text-link" href={course('cierre_secundario')}>Quiero más información <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></section>
</main><footer class="container footer"><a class="wordmark" href="#inicio">iTR<span>+</span></a><p>Formación especializada en investigación<br/>digital mediante fuentes abiertas.</p><a href={contact('pie')}>Contactar con iTR+ <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a><p class="small">Sin analítica ni cookies de marketing activas.<br/>© {new Date().getFullYear()} iTR+</p></footer><aside class="mobile-cta" hidden><a class="button" href={contact('movil')}>Solicitar información <svg class="arrow-icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 19 19 5M5 5h14v14"/></svg></a></aside>
<script>
 import {track} from '../lib/analytics';
 const modules=document.querySelectorAll<HTMLDetailsElement>('[data-module]');
 document.getElementById('expand')?.addEventListener('click',()=>modules.forEach(d=>d.open=true));
 document.getElementById('collapse')?.addEventListener('click',()=>modules.forEach(d=>d.open=false));
 modules.forEach(d=>d.addEventListener('toggle',()=>{if(d.open)track('program_open',{module_id:d.dataset.module})}));
 document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach(d=>d.addEventListener('toggle',()=>{if(d.open)track('faq_open',{section_id:'preguntas'})}));
 document.querySelectorAll<HTMLAnchorElement>('a[href*="perinfor.odoo.com"]').forEach(a=>a.addEventListener('click',()=>track(a.pathname.includes('/slides/')?'course_platform_click':'cta_info_click',{cta_id:new URL(a.href).searchParams.get('utm_content')||'enlace',destination_type:a.pathname.includes('/slides/')?'course':'contact'})));
 const menu=document.querySelector<HTMLDetailsElement>('.mobile-menu');menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>menu.open=false));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus()}});
 const bar=document.querySelector<HTMLElement>('.mobile-cta');new IntersectionObserver(e=>{if(bar)bar.hidden=e[0].isIntersecting}).observe(document.getElementById('inicio')!);
 const links=document.querySelectorAll<HTMLAnchorElement>('.header nav a[href^="#"]');const activeObserver=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)links.forEach(a=>{if(a.hash==='#'+e.target.id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})}),{rootMargin:'-15% 0px -60% 0px'});document.querySelectorAll('main>section[id]').forEach(section=>activeObserver.observe(section));
 // CSS fallback follows the same local pointer coordinates, independent of WebGL.
 const hero=document.getElementById('inicio')!,art=document.querySelector<HTMLElement>('.hero-art')!;
 const media=matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');let tx=0,ty=0,px=0,py=0,frame=0,visible=true;
 const reducedMotion=matchMedia('(prefers-reduced-motion:reduce)');
 const coarsePointer=matchMedia('(pointer:coarse)');
 const compactHero=matchMedia('(max-width:800px)');
 const animationToggle=document.getElementById('animation-toggle') as HTMLButtonElement;
 let animationPaused=false;
 function updateAnimation(){
   const connection=(navigator as Navigator & {connection?:{saveData:boolean}}).connection;
   const allowed=!reducedMotion.matches&&!coarsePointer.matches&&!compactHero.matches&&!connection?.saveData;
   hero.classList.toggle('investigation-animated',allowed);
   hero.classList.toggle('investigation-paused',animationPaused||!visible||document.hidden);
   animationToggle.hidden=!allowed;
   animationToggle.setAttribute('aria-pressed',String(animationPaused));
   animationToggle.textContent=animationPaused?'Reanudar animación':'Pausar animación';
 }
 animationToggle.addEventListener('click',()=>{animationPaused=!animationPaused;updateAnimation()});
 reducedMotion.addEventListener('change',updateAnimation);coarsePointer.addEventListener('change',updateAnimation);compactHero.addEventListener('change',updateAnimation);
 document.addEventListener('visibilitychange',updateAnimation);
 new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;updateAnimation()}).observe(hero);
 updateAnimation();
 function tick(){frame=0;if(!visible||document.hidden||!media.matches)return;px+=(tx-px)*.12;py+=(ty-py)*.12;art.style.transform=`translate3d(${px}px,${py}px,0) rotateY(${px/12}deg) rotateX(${-py/12}deg)`;if(Math.abs(tx-px)+Math.abs(ty-py)>.02)frame=requestAnimationFrame(tick)}
 function schedule(){if(!frame)frame=requestAnimationFrame(tick)}
 hero.addEventListener('pointermove',e=>{if(!media.matches)return;const r=hero.getBoundingClientRect();tx=Math.max(-24,Math.min(24,((e.clientX-r.left)/r.width*2-1)*24));ty=Math.max(-18,Math.min(18,((e.clientY-r.top)/r.height*2-1)*18));schedule()},{passive:true});hero.addEventListener('pointerleave',()=>{tx=ty=0;schedule()});media.addEventListener('change',()=>{tx=ty=px=py=0;art.style.transform='none';cancelAnimationFrame(frame);frame=0});new IntersectionObserver(e=>{visible=e[0].isIntersecting;if(!visible){cancelAnimationFrame(frame);frame=0}else schedule()}).observe(hero);document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(frame);frame=0}else schedule()});
</script></body></html>
